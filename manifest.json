{
  "manifest_version": 3,
  "name": "YouTube DeepSeek 字幕翻译",
  "version": "1.8.2",
  "minimum_chrome_version": "102",
  "description": "使用你自己的 DeepSeek API Key 预翻译或实时翻译 YouTube 字幕。",
  "icons": {
    "16": "assets/extension-icon-16.png",
    "32": "assets/extension-icon-32.png",
    "48": "assets/extension-icon-48.png",
    "128": "assets/extension-icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "assets/extension-icon-16.png",
      "32": "assets/extension-icon-32.png",
      "48": "assets/extension-icon-48.png",
      "128": "assets/extension-icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "YouTube DeepSeek 字幕翻译"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "shared.js",
        "word-lookup-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
